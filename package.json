    "@mediapipe/hands": "^0.4.1675469240",
    "@msgpack/msgpack": "^3.1.3",
    "@trystero-p2p/firebase": "^0.23.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.181.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",

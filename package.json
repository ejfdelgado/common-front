{
  "name": "common-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "start:prod": "ng serve --ssl --configuration=production",
    "angular": "npm run start",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",

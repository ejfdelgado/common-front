{
  "name": "common-front",
  "version": "2.0.0",
  "scripts": {
    "bip": "ffplay /sound/finish.mp3 -nodisp -nostats -hide_banner -autoexit",
    "ng": "ng",
    "start": "ng serve --ssl",
    "start:prod": "ng serve --ssl --configuration=production",
    "angular": "npm run start",
    "build": "ng build",
    "install_local": "npm install --legacy-peer-deps",
    "build:prod": "ng build --configuration=production --output-path=appengine/public --stats-json",
    "deploy": "cd appengine && gcloud app deploy --quiet --project=proyeccion-colombia1 && cd .. && npm run bip",
    "publish": "npm run build:prod && npm run deploy",
    "watch": "ng build --watch --configuration development",
    "myinstall": "npm install --legacy-peer-deps",
    "analyze": "npx webpack-bundle-analyzer appengine/public/stats.json",
    "copy_version": "node admin_manager.mjs copyVersion"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.11",
